---
const phoneNumber = '5215551234567';
const message = encodeURIComponent('Hola NOMI SMART, me gustaría recibir más información.');
const href = `https://wa.me/${phoneNumber}?text=${message}`;
---

<a
	href={href}
	target="_blank"
	rel="noreferrer"
	aria-label="Abrir conversación en WhatsApp"
	class="fixed bottom-5 right-5 z-50 inline-flex h-14 w-14 items-center justify-center rounded-full bg-[#25D366] text-white shadow-xl shadow-emerald-500/30 transition duration-200 hover:scale-105 hover:bg-[#1fb957] focus:outline-none focus:ring-4 focus:ring-emerald-300 sm:bottom-6 sm:right-6 sm:h-16 sm:w-16"
>
	<span class="sr-only">WhatsApp</span>
	<svg viewBox="0 0 32 32" class="h-7 w-7 sm:h-8 sm:w-8" fill="currentColor" aria-hidden="true">
