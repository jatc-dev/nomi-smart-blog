---
const navigationItems = [
	{ href: '/', label: 'Inicio' },
	{ href: '/nosotros', label: 'NOMI SMART' },
	{ href: '/servicios', label: 'Servicios' },
	{ href: '/como-funciona', label: 'Cómo Funciona' },
	{ href: '/blog', label: 'Blog' },
	{ href: '/capacitaciones', label: 'Capacitaciones' },
	{ href: '/descargables', label: 'Descargables' },
	{ href: '/contacto', label: 'Contacto' },
];
---

<header class="sticky top-0 z-50 border-b border-slate-200/80 bg-slate-50/90 backdrop-blur-xl">
	<div class="mx-auto flex w-full max-w-6xl items-center justify-between px-4 py-4 sm:px-6 lg:px-8">
		<a href="/" class="group flex items-center gap-3 text-slate-950 no-underline" aria-label="NOMI SMART home">
			<span class="flex h-11 w-11 items-center justify-center rounded-2xl bg-slate-950 text-sm font-black tracking-[0.24em] text-white shadow-lg shadow-slate-950/15 transition-transform duration-200 group-hover:-translate-y-0.5">
				NS
			</span>
			<span class="flex flex-col leading-tight">
				<span class="text-sm font-black uppercase tracking-[0.34em] text-slate-950">NOMI SMART</span>
				<span class="text-xs font-medium text-slate-500">Estrategia, contenido y crecimiento</span>
			</span>
		</a>

		<nav class="hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
			{navigationItems.map((item) => (
				<a
					href={item.href}
					class:list={[
						'relative rounded-full px-4 py-2 text-sm font-medium text-slate-700 transition-colors duration-200 hover:bg-slate-900 hover:text-white',
						item.href === '/' ? 'hover:bg-slate-900 hover:text-white' : '',
					]}
				>
					{item.label}
				</a>
			))}
		</nav>

		<button
			type="button"
			class="inline-flex items-center justify-center rounded-2xl border border-slate-200 bg-white p-3 text-slate-900 shadow-sm transition hover:border-slate-300 hover:bg-slate-100 lg:hidden"
			aria-controls="mobile-menu"
			aria-expanded="false"
			data-menu-button
		>
			<span class="sr-only">Abrir menú</span>
			<svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
				<path d="M4 6h16" />
				<path d="M4 12h16" />
				<path d="M4 18h16" />
			</svg>
		</button>
	</div>

	<div id="mobile-menu" class="hidden border-t border-slate-200 bg-white lg:hidden" data-mobile-menu>
		<nav class="mx-auto flex w-full max-w-6xl flex-col gap-1 px-4 py-4 sm:px-6 lg:px-8" aria-label="Navegación móvil">
			{navigationItems.map((item) => (
				<a
					href={item.href}
					class="rounded-2xl px-4 py-3 text-base font-medium text-slate-700 transition hover:bg-slate-950 hover:text-white"
					data-mobile-link
				>
					{item.label}
				</a>
			))}
		</nav>
	</div>
</header>

<script is:inline>
	const menuButton = document.querySelector('[data-menu-button]');
	const mobileMenu = document.querySelector('[data-mobile-menu]');

	if (menuButton && mobileMenu) {
		const setExpanded = (expanded) => {
			menuButton.setAttribute('aria-expanded', String(expanded));
			mobileMenu.classList.toggle('hidden', !expanded);
			menuButton.setAttribute('aria-label', expanded ? 'Cerrar menú' : 'Abrir menú');
		};

		menuButton.addEventListener('click', () => {
			const expanded = menuButton.getAttribute('aria-expanded') === 'true';
			setExpanded(!expanded);
		});

		mobileMenu.addEventListener('click', (event) => {
			if (event.target instanceof HTMLAnchorElement) {
				setExpanded(false);
			}
		});

		window.addEventListener('resize', () => {
			if (window.innerWidth >= 1024) {
				setExpanded(false);
			}
		});
	}
</script>