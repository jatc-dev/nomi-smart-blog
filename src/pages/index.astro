---
import Layout from '../layouts/Layout.astro';

const quickLinks = [
	{
		href: '/blog',
		label: 'Artículos',
		description: 'Guías y análisis sobre nómina, IMSS, ISR y cumplimiento laboral.',
		tone: 'from-sky-500 to-cyan-400',
	},
	{
		href: '/capacitaciones',
		label: 'Capacitaciones',
		description: 'Sesiones prácticas para equipos de RR. HH., contabilidad y administración.',
		tone: 'from-emerald-500 to-teal-400',
	},
	{
		href: '/descargables',
		label: 'Descargables',
		description: 'Plantillas, checklists y recursos listos para implementar.',
		tone: 'from-amber-500 to-orange-400',
	},
	{
		href: '/contacto',
		label: 'Contacto',
		description: 'Agenda una conversación para resolver tus dudas o diseñar una solución.',
		tone: 'from-fuchsia-500 to-pink-400',
	},
];

const featuredContent = [
	{
		tag: 'Nómina',
		title: 'Errores comunes que disparan riesgos de seguridad social',
		description: 'Revisa los puntos críticos que suelen pasar desapercibidos en el cálculo y control de la nómina.',
	},
	{
		tag: 'Cumplimiento',
		title: 'Checklist esencial para auditar tu operación antes del cierre',
		description: 'Una guía breve para validar incidencias, movimientos y documentación antes de reportar.',
	},
	{
		tag: 'Capacitación',
		title: 'Qué debe dominar tu equipo para operar con mayor control',
		description: 'Formación enfocada en procesos, criterios y hábitos que reducen errores recurrentes.',
	},
];
---

<Layout
	title="NOMI SMART | Nómina, seguridad social y cumplimiento"
	description="NOMI SMART ayuda a equipos de RR. HH. y administración a dominar nómina, seguridad social y cumplimiento con contenido, capacitación y recursos prácticos."
>
	<section class="relative overflow-hidden rounded-[2rem] border border-slate-200 bg-slate-950 px-6 py-16 text-white shadow-2xl shadow-slate-950/10 sm:px-10 lg:px-14">
		<div class="absolute inset-0 bg-[radial-gradient(circle_at_top_right,_rgba(56,189,248,0.35),_transparent_35%),radial-gradient(circle_at_bottom_left,_rgba(16,185,129,0.22),_transparent_30%)]"></div>
		<div class="relative grid gap-12 lg:grid-cols-[1.2fr_0.8fr] lg:items-center">
			<div class="max-w-3xl">
				<p class="mb-4 inline-flex rounded-full border border-white/10 bg-white/5 px-4 py-2 text-xs font-semibold uppercase tracking-[0.32em] text-sky-200">
					Nómina con criterio
				</p>
				<h1 class="text-4xl font-black tracking-tight text-white sm:text-5xl lg:text-6xl">
					Domina la nómina y la seguridad social con información clara, útil y accionable.
				</h1>
				<p class="mt-6 max-w-2xl text-base leading-7 text-slate-300 sm:text-lg">
					NOMI SMART reúne contenidos, recursos y capacitación para ayudarte a tomar mejores decisiones, reducir errores y fortalecer el control operativo.
				</p>
				<div class="mt-8 flex flex-col gap-4 sm:flex-row">
					<a
						href="/contacto"
						class="inline-flex items-center justify-center rounded-full bg-white px-6 py-3 text-sm font-semibold text-slate-950 transition hover:bg-slate-100"
					>
						Solicitar asesoría
					</a>
					<a
						href="/blog"
						class="inline-flex items-center justify-center rounded-full border border-white/15 bg-white/5 px-6 py-3 text-sm font-semibold text-white transition hover:bg-white/10"
					>
						Explorar artículos
					</a>
				</div>
			</div>

        <div class="technical-data">
            ERR_CODE: 503_SERVICE_SUSPENDED<br>
            CLUSTER_ID: edge-vcl-994x-us-east<br>
            ROUTE_HASH: 0x9f8b4c21e7a<br>
            SESSION_STATE: DRAINED
        </div>
    </div>

		<div class="mt-8 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
			{quickLinks.map((link) => (
				<a href={link.href} class="group rounded-[1.5rem] border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-200/60">
					<div class={`mb-5 h-2 w-16 rounded-full bg-gradient-to-r ${link.tone}`}></div>
					<h3 class="text-xl font-bold text-slate-950">{link.label}</h3>
					<p class="mt-3 text-sm leading-6 text-slate-600">{link.description}</p>
					<span class="mt-6 inline-flex text-sm font-semibold text-slate-900 transition group-hover:translate-x-1">Ir a sección</span>
				</a>
			))}
		</div>
	</section>

	<section class="mt-16 grid gap-8 lg:grid-cols-[0.95fr_1.05fr] lg:items-start">
		<div class="rounded-[1.75rem] border border-slate-200 bg-white p-8 shadow-sm">
			<p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-500">Sobre NOMI SMART</p>
			<h2 class="mt-4 text-3xl font-black tracking-tight text-slate-950">Contenido práctico para equipos que operan con responsabilidad</h2>
			<p class="mt-5 text-base leading-7 text-slate-600">
				Ayudamos a profesionales de nómina, recursos humanos y administración a entender mejor sus procesos, implementar buenas prácticas y mantener una operación más segura.
			</p>
			<p class="mt-4 text-base leading-7 text-slate-600">
				Nuestra propuesta combina artículos, capacitaciones y descargables pensados para resolver dudas reales y acompañar la toma de decisiones.
			</p>
		</div>

		<div>
			<div class="flex items-end justify-between gap-4">
				<div>
					<p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-500">Destacados</p>
					<h2 class="mt-3 text-2xl font-black tracking-tight text-slate-950 sm:text-3xl">Contenidos que te ayudan a avanzar</h2>
				</div>
			</div>

			<div class="mt-8 grid gap-5">
				{featuredContent.map((item) => (
					<article class="rounded-[1.5rem] border border-slate-200 bg-slate-50 p-6 shadow-sm transition hover:border-slate-300 hover:bg-white">
						<p class="text-sm font-semibold uppercase tracking-[0.24em] text-sky-700">{item.tag}</p>
						<h3 class="mt-3 text-xl font-bold text-slate-950">{item.title}</h3>
						<p class="mt-3 text-sm leading-6 text-slate-600">{item.description}</p>
					</article>
				))}
			</div>
		</div>
	</section>
</Layout>
