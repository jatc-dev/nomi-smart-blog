---
import Layout from '../layouts/Layout.astro';

const steps = [
	{
		number: '01',
		title: 'Explora el centro de conocimiento',
		description: 'Ingresa a los artículos para revisar temas clave de nómina, seguridad social, procesos y cumplimiento.',
	},
	{
		number: '02',
		title: 'Revisa las capacitaciones',
		description: 'Consulta las sesiones disponibles para aprender de forma estructurada y resolver dudas con apoyo práctico.',
	},
	{
		number: '03',
		title: 'Descarga recursos útiles',
		description: 'Usa plantillas, listas de verificación y materiales descargables para estandarizar y organizar mejor tu trabajo.',
	},
	{
		number: '04',
		title: 'Contacta a NOMI SMART',
		description: 'Cuando necesites acompañamiento o una guía más puntual, usa el contacto para plantear tus necesidades.',
	},
];
---

<Layout
	title="Cómo funciona | NOMI SMART"
	description="Descubre paso a paso cómo navegar y utilizar el centro de conocimiento, capacitaciones y descargas de NOMI SMART."
>
	<section class="rounded-[2rem] border border-slate-200 bg-white px-6 py-12 shadow-sm sm:px-10 lg:px-14">
		<div class="max-w-3xl">
			<p class="inline-flex rounded-full bg-emerald-50 px-4 py-2 text-xs font-semibold uppercase tracking-[0.3em] text-emerald-700">
				Cómo funciona
			</p>
			<h1 class="mt-5 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">
				Una guía simple para aprovechar NOMI SMART paso a paso.
			</h1>
			<p class="mt-6 text-base leading-7 text-slate-600 sm:text-lg">
				El sitio está organizado para que encuentres rápido lo que necesitas: conocimiento, formación y recursos descargables en un solo lugar.
			</p>
		</div>
	</section>

	<section class="mt-10 grid gap-5 lg:grid-cols-2 xl:grid-cols-4">
		{steps.map((step) => (
			<article class="rounded-[1.5rem] border border-slate-200 bg-slate-50 p-6 shadow-sm transition hover:-translate-y-1 hover:bg-white hover:shadow-lg hover:shadow-slate-200/60">
				<p class="text-sm font-black uppercase tracking-[0.28em] text-sky-700">Paso {step.number}</p>
				<h2 class="mt-4 text-xl font-bold text-slate-950">{step.title}</h2>
				<p class="mt-3 text-sm leading-6 text-slate-600">{step.description}</p>
			</article>
		))}
	</section>

	<section class="mt-10 grid gap-8 lg:grid-cols-[1.05fr_0.95fr] lg:items-start">
		<article class="rounded-[1.75rem] border border-slate-200 bg-slate-950 p-8 text-white shadow-2xl shadow-slate-950/10">
			<p class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-200">Centro de conocimiento</p>
			<h2 class="mt-4 text-3xl font-black tracking-tight text-white">Empieza por leer, comparar y entender</h2>
			<p class="mt-5 text-base leading-7 text-slate-300">
				El centro de conocimiento reúne artículos y materiales pensados para ayudarte a comprender conceptos, aclarar dudas y avanzar con más confianza.
			</p>
		</article>

		<div class="grid gap-5">
			<article class="rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-sm">
				<p class="text-sm font-semibold uppercase tracking-[0.28em] text-slate-500">Capacitaciones</p>
				<p class="mt-3 text-sm leading-6 text-slate-600">Consulta la oferta de formación, identifica el tema que necesitas y revisa cómo se adapta al trabajo de tu equipo.</p>
			</article>
			<article class="rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-sm">
				<p class="text-sm font-semibold uppercase tracking-[0.28em] text-slate-500">Descargas</p>
				<p class="mt-3 text-sm leading-6 text-slate-600">Descarga recursos listos para usar y llévalos a tu operación diaria para estandarizar tareas y procesos.</p>
			</article>
			<article class="rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-sm">
				<p class="text-sm font-semibold uppercase tracking-[0.28em] text-slate-500">Contacto</p>
				<p class="mt-3 text-sm leading-6 text-slate-600">Si necesitas ayuda para interpretar, implementar o resolver algo específico, usa el contacto para solicitar acompañamiento.</p>
			</article>
		</div>
	</section>
</Layout>