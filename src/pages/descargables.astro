---
import Layout from '../layouts/Layout.astro';

const resources = [
	{
		title: 'Checklist de cierre de nómina',
		description: 'Lista práctica para revisar incidencias, validaciones y pendientes antes de cerrar el periodo.',
		format: 'PDF',
		size: '1.2 MB',
		href: '/downloads/checklist-cierre-nomina.pdf',
		icon: 'pdf',
	},
	{
		title: 'Guía de seguridad social y PILA',
		description: 'Resumen operativo para validar aportes, novedades y control documental antes de enviar información.',
		format: 'Guía',
		size: '980 KB',
		href: '/downloads/guia-seguridad-social-pila.pdf',
		icon: 'guide',
	},
	{
		title: 'Manual básico de liquidación de nómina',
		description: 'Documento de consulta rápida con pasos esenciales para comprender el flujo general de liquidación.',
		format: 'Manual',
		size: '1.8 MB',
		href: '/downloads/manual-liquidacion-nomina.pdf',
		icon: 'manual',
	},
	{
		title: 'Infografía de validaciones clave',
		description: 'Resumen visual de los puntos críticos que conviene revisar antes de publicar o reportar.',
		format: 'Infografía',
		size: '740 KB',
		href: '/downloads/infografia-validaciones-nomina.pdf',
		icon: 'infographic',
	},
];

const iconStyles = {
	pdf: 'bg-rose-500 text-white',
	guide: 'bg-sky-500 text-white',
	manual: 'bg-emerald-500 text-white',
	infographic: 'bg-amber-500 text-white',
};

const iconLabels = {
	pdf: 'PDF',
	guide: 'G',
	manual: 'M',
	infographic: 'I',
};
---

<Layout
	title="Descargables | NOMI SMART"
	description="Recursos descargables de NOMI SMART: PDFs, guías, manuales e infografías para apoyar la gestión de nómina y seguridad social."
>
	<section class="rounded-[2rem] border border-slate-200 bg-white px-6 py-12 shadow-sm sm:px-10 lg:px-14">
		<div class="max-w-3xl">
			<p class="inline-flex rounded-full bg-amber-50 px-4 py-2 text-xs font-semibold uppercase tracking-[0.3em] text-amber-700">
				Descargables
			</p>
			<h1 class="mt-5 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">
				Recursos educativos listos para descargar y aplicar.
			</h1>
			<p class="mt-6 text-base leading-7 text-slate-600 sm:text-lg">
				Encuentra PDFs, guías, manuales e infografías diseñadas para acompañar procesos de nómina, seguridad social y capacitación con materiales útiles y fáciles de consultar.
			</p>
		</div>
	</section>

	<section class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4">
		{resources.map((resource) => (
			<article class="flex h-full flex-col rounded-[1.5rem] border border-slate-200 bg-slate-50 p-6 shadow-sm transition hover:-translate-y-1 hover:bg-white hover:shadow-lg hover:shadow-slate-200/60">
				<div class="flex items-center gap-4">
					<div class={`flex h-12 w-12 shrink-0 items-center justify-center rounded-2xl text-sm font-black uppercase ${iconStyles[resource.icon]}`}>
						{iconLabels[resource.icon]}
					</div>
					<div>
						<p class="text-xs font-semibold uppercase tracking-[0.28em] text-slate-500">{resource.format}</p>
						<p class="mt-1 text-sm text-slate-500">Tamaño estimado: {resource.size}</p>
					</div>
				</div>

				<h2 class="mt-5 text-xl font-bold text-slate-950">{resource.title}</h2>
				<p class="mt-3 text-sm leading-6 text-slate-600">{resource.description}</p>

				<div class="mt-6 pt-4">
					<a
						href={resource.href}
						download
						class="inline-flex w-full items-center justify-center rounded-full bg-slate-950 px-5 py-3 text-sm font-semibold text-white transition hover:bg-slate-800"
					>
						Descargar archivo
					</a>
				</div>
			</article>
		))}
	</section>

	<section class="mt-10 rounded-[2rem] border border-slate-200 bg-slate-950 p-6 text-white shadow-2xl shadow-slate-950/10 sm:p-8 lg:p-10">
		<div class="max-w-3xl">
			<p class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-200">Uso recomendado</p>
			<h2 class="mt-4 text-3xl font-black tracking-tight text-white">Descarga, revisa y adapta el material a tu proceso</h2>
			<p class="mt-5 text-base leading-7 text-slate-300">
				Estos recursos están pensados como apoyo operativo. Úsalos como punto de partida para documentar, revisar o capacitar a tu equipo con mayor orden.
			</p>
		</div>
	</section>
</Layout>