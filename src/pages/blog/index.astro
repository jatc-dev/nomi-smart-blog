---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('blog')).sort((left, right) => right.data.pubDate.valueOf() - left.data.pubDate.valueOf());
const getPostSlug = (post) => post.slug ?? post.id.split('/').pop() ?? post.id;

const categories = [...new Set(posts.map((post) => post.data.category))];
const groupedPosts = Object.fromEntries(categories.map((category) => [category, posts.filter((post) => post.data.category === category)]));
---

<Layout
	title="Blog | NOMI SMART"
	description="Explora artículos de NOMI SMART organizados por categoría: nómina, seguridad social, capacitación y cumplimiento."
>
	<section class="rounded-[2rem] border border-slate-200 bg-white px-6 py-12 shadow-sm sm:px-10 lg:px-14">
		<div class="max-w-3xl">
			<p class="inline-flex rounded-full bg-sky-50 px-4 py-2 text-xs font-semibold uppercase tracking-[0.3em] text-sky-700">Blog</p>
			<h1 class="mt-5 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">Centro de artículos organizados por categoría</h1>
			<p class="mt-6 text-base leading-7 text-slate-600 sm:text-lg">
				Revisa contenido práctico sobre nómina, seguridad social, capacitación y cumplimiento para avanzar con más contexto y menos incertidumbre.
			</p>
		</div>
	</section>

	<section class="mt-10 space-y-10">
		{categories.map((category) => (
			<div>
				<div class="flex items-end justify-between gap-4">
					<div>
						<p class="text-sm font-semibold uppercase tracking-[0.3em] text-slate-500">{category}</p>
						<h2 class="mt-3 text-2xl font-black tracking-tight text-slate-950 sm:text-3xl">Artículos destacados</h2>
					</div>
				</div>

				<div class="mt-6 grid gap-5 md:grid-cols-2 xl:grid-cols-3">
					{groupedPosts[category].map((post) => (
						<a href={`/blog/${getPostSlug(post)}`} class="group overflow-hidden rounded-[1.5rem] border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl hover:shadow-slate-200/60">
							<img src={post.data.image} alt={post.data.title} class="h-48 w-full object-cover" loading="lazy" />
							<div class="p-6">
								<p class="text-sm font-semibold uppercase tracking-[0.24em] text-sky-700">{post.data.category}</p>
								<h3 class="mt-3 text-xl font-bold text-slate-950">{post.data.title}</h3>
								<p class="mt-3 text-sm leading-6 text-slate-600">{post.data.description}</p>
								<div class="mt-6 flex items-center justify-between text-sm text-slate-500">
									<span>{post.data.author}</span>
									<span>{post.data.pubDate.toLocaleDateString('es-ES')}</span>
								</div>
							</div>
						</a>
					))}
				</div>
			</div>
		))}
	</section>
</Layout>