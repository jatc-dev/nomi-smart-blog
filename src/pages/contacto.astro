---
import Layout from '../layouts/Layout.astro';

const phoneNumber = '5215551234567';
const whatsappMessage = encodeURIComponent('Hola NOMI SMART, quiero recibir información y apoyo.');
const whatsappHref = `https://wa.me/${phoneNumber}?text=${whatsappMessage}`;
---

<Layout
	title="Contacto | NOMI SMART"
	description="Ponte en contacto con NOMI SMART mediante formulario, correo, redes sociales o chat directo por WhatsApp."
>
	<section class="rounded-[2rem] border border-slate-200 bg-white px-6 py-12 shadow-sm sm:px-10 lg:px-14">
		<div class="max-w-3xl">
			<p class="inline-flex rounded-full bg-fuchsia-50 px-4 py-2 text-xs font-semibold uppercase tracking-[0.3em] text-fuchsia-700">
				Contacto
			</p>
			<h1 class="mt-5 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">
				Hablemos de nómina, capacitación y recursos para tu equipo.
			</h1>
			<p class="mt-6 text-base leading-7 text-slate-600 sm:text-lg">
				Usa el formulario, escríbenos por correo o inicia un chat directo por WhatsApp para recibir información sobre NOMI SMART.
			</p>
		</div>
	</section>

	<section class="mt-10 grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
		<form class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
			<div class="grid gap-5 sm:grid-cols-2">
				<label class="block">
					<span class="mb-2 block text-sm font-semibold text-slate-700">Nombre</span>
					<input
						type="text"
						name="name"
						placeholder="Tu nombre"
						class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:ring-4 focus:ring-sky-100"
					/>
				</label>

				<label class="block">
					<span class="mb-2 block text-sm font-semibold text-slate-700">Correo</span>
					<input
						type="email"
						name="email"
						placeholder="tu@correo.com"
						class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:ring-4 focus:ring-sky-100"
					/>
				</label>
			</div>

			<div class="mt-5 grid gap-5 sm:grid-cols-2">
				<label class="block">
					<span class="mb-2 block text-sm font-semibold text-slate-700">Teléfono</span>
					<input
						type="tel"
						name="phone"
						placeholder="55 1234 5678"
						class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:ring-4 focus:ring-sky-100"
					/>
				</label>

				<label class="block">
					<span class="mb-2 block text-sm font-semibold text-slate-700">Asunto</span>
					<input
						type="text"
						name="subject"
						placeholder="¿En qué podemos ayudarte?"
						class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:ring-4 focus:ring-sky-100"
					/>
				</label>
			</div>

			<label class="mt-5 block">
				<span class="mb-2 block text-sm font-semibold text-slate-700">Mensaje</span>
				<textarea
					name="message"
					rows="7"
					placeholder="Cuéntanos tu necesidad o proyecto..."
					class="w-full rounded-[1.5rem] border border-slate-300 bg-slate-50 px-4 py-3 text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:ring-4 focus:ring-sky-100"
				></textarea>
			</label>

			<div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<p class="text-sm text-slate-500">Este formulario está listo para integrar con tu canal de atención o backend cuando lo necesites.</p>
				<button type="submit" class="inline-flex items-center justify-center rounded-full bg-slate-950 px-6 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">
					Enviar mensaje
				</button>
			</div>
		</form>

		<div class="space-y-6">
			<article class="rounded-[2rem] border border-slate-200 bg-slate-950 p-6 text-white shadow-2xl shadow-slate-950/10 sm:p-8">
				<p class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-200">WhatsApp</p>
				<h2 class="mt-4 text-3xl font-black tracking-tight text-white">Respuesta rápida por chat directo</h2>
				<p class="mt-5 text-base leading-7 text-slate-300">
					Si prefieres una conversación inmediata, abre el chat y cuéntanos qué necesitas. Es la vía más rápida para iniciar.
				</p>
				<a href={whatsappHref} target="_blank" rel="noreferrer" class="mt-7 inline-flex items-center justify-center rounded-full bg-[#25D366] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#1fb957]">
					Abrir WhatsApp
				</a>
			</article>

			<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
				<article class="rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-sm">
					<p class="text-sm font-semibold uppercase tracking-[0.28em] text-slate-500">Correo</p>
					<a class="mt-3 block text-lg font-bold text-slate-950 transition hover:text-sky-700" href="mailto:hola@nomismart.com">hola@nomismart.com</a>
				</article>

				<article class="rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-sm">
					<p class="text-sm font-semibold uppercase tracking-[0.28em] text-slate-500">Redes sociales</p>
					<ul class="mt-4 space-y-3 text-sm text-slate-600">
						<li><a class="transition hover:text-slate-950" href="https://instagram.com/nomismart" target="_blank" rel="noreferrer">Instagram</a></li>
						<li><a class="transition hover:text-slate-950" href="https://linkedin.com/company/nomismart" target="_blank" rel="noreferrer">LinkedIn</a></li>
						<li><a class="transition hover:text-slate-950" href="https://facebook.com/nomismart" target="_blank" rel="noreferrer">Facebook</a></li>
					</ul>
				</article>
			</div>
		</div>
	</section>
</Layout>