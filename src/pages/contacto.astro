---
import Layout from '../layouts/Layout.astro';
import { contactInfo } from '../config/contact';
---

<Layout
	title="Contacto | NOMI SMART"
	description="Ponte en contacto con NOMI SMART mediante formulario, correo, redes sociales o chat directo por WhatsApp."
>
	<section class="rounded-[2rem] border border-slate-200 bg-white px-6 py-12 shadow-sm sm:px-10 lg:px-14">
		<div class="max-w-3xl">
			<p class="inline-flex rounded-full bg-fuchsia-50 px-4 py-2 text-xs font-semibold uppercase tracking-[0.3em] text-fuchsia-700">
				Contacto
			</p>
			<h1 class="mt-5 text-4xl font-black tracking-tight text-slate-950 sm:text-5xl">
				Hablemos de nómina, capacitación y recursos para tu equipo.
			</h1>
			<p class="mt-6 text-base leading-7 text-slate-600 sm:text-lg">
				Usa el formulario, escríbenos por correo o inicia un chat directo por WhatsApp para recibir información sobre NOMI SMART.
			</p>
		</div>
	</section>

	<section class="mt-10 grid gap-8 lg:grid-cols-[1.15fr_0.85fr] lg:items-start">
		<form class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
			<div class="grid gap-5 sm:grid-cols-2">
				<label class="block">
					<span class="mb-2 block text-sm font-semibold text-slate-700">Nombre</span>
					<input
						type="text"
						name="name"
						placeholder="Tu nombre"
						class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:ring-4 focus:ring-sky-100"
					/>
				</label>

				<label class="block">
					<span class="mb-2 block text-sm font-semibold text-slate-700">Correo</span>
					<input
						type="email"
						name="email"
						placeholder="tu@correo.com"
						class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:ring-4 focus:ring-sky-100"
					/>
				</label>
			</div>

			<div class="mt-5 grid gap-5 sm:grid-cols-2">
				<label class="block">
					<span class="mb-2 block text-sm font-semibold text-slate-700">Teléfono</span>
					<input
						type="tel"
						name="phone"
						placeholder="55 1234 5678"
						class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:ring-4 focus:ring-sky-100"
					/>
				</label>

				<label class="block">
					<span class="mb-2 block text-sm font-semibold text-slate-700">Asunto</span>
					<input
						type="text"
						name="subject"
						placeholder="¿En qué podemos ayudarte?"
						class="w-full rounded-2xl border border-slate-300 bg-slate-50 px-4 py-3 text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:ring-4 focus:ring-sky-100"
					/>
				</label>
			</div>

			<label class="mt-5 block">
				<span class="mb-2 block text-sm font-semibold text-slate-700">Mensaje</span>
				<textarea
					name="message"
					rows="7"
					placeholder="Cuéntanos tu necesidad o proyecto..."
					class="w-full rounded-[1.5rem] border border-slate-300 bg-slate-50 px-4 py-3 text-slate-950 outline-none transition placeholder:text-slate-400 focus:border-sky-500 focus:bg-white focus:ring-4 focus:ring-sky-100"
				></textarea>
			</label>

			<div class="mt-6 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
				<p class="text-sm text-slate-500">Este formulario está listo para integrar con tu canal de atención o backend cuando lo necesites.</p>
				<button type="submit" class="inline-flex items-center justify-center rounded-full bg-slate-950 px-6 py-3 text-sm font-semibold text-white transition hover:bg-slate-800">
					Enviar mensaje
				</button>
			</div>
		</form>

		<div class="space-y-6">
			<article class="rounded-[2rem] border border-slate-200 bg-slate-950 p-6 text-white shadow-2xl shadow-slate-950/10 sm:p-8">
				<p class="text-sm font-semibold uppercase tracking-[0.3em] text-sky-200">WhatsApp</p>
				<h2 class="mt-4 text-3xl font-black tracking-tight text-white">Respuesta rápida por chat directo</h2>
				<p class="mt-5 text-base leading-7 text-slate-300">
					Si prefieres una conversación inmediata, abre el chat y cuéntanos qué necesitas. Es la vía más rápida para iniciar.
				</p>
				<a href={contactInfo.whatsappHref} target="_blank" rel="noopener noreferrer" class="mt-7 inline-flex items-center justify-center gap-3 rounded-full bg-[#25D366] px-6 py-3 text-sm font-semibold text-white transition hover:bg-[#1fb957]">
					<svg class="h-5 w-5" viewBox="0 0 32 32" fill="currentColor" aria-hidden="true">
						<path d="M19.11 17.54c-.28-.14-1.64-.81-1.89-.9-.25-.09-.43-.14-.61.14-.18.28-.7.9-.86 1.09-.16.18-.32.2-.59.07-.28-.14-1.17-.43-2.22-1.37-.82-.73-1.37-1.63-1.53-1.91-.16-.28-.02-.43.12-.57.12-.12.28-.32.42-.48.14-.16.18-.28.28-.46.09-.18.05-.34-.02-.48-.07-.14-.61-1.47-.84-2.01-.22-.54-.45-.46-.61-.46h-.52c-.18 0-.48.07-.73.34-.25.28-.96.93-.96 2.27s.98 2.64 1.11 2.82c.14.18 1.92 2.93 4.66 4.11.65.28 1.15.45 1.54.57.65.21 1.25.18 1.72.11.53-.08 1.64-.67 1.87-1.32.23-.65.23-1.2.16-1.32-.07-.12-.25-.2-.53-.34Zm-3.11 8.84h-.01c-2.21 0-4.39-.59-6.3-1.7l-.45-.27-4.67 1.22 1.25-4.55-.29-.47a12.4 12.4 0 0 1-1.91-6.62c0-6.83 5.56-12.39 12.4-12.39 3.31 0 6.41 1.29 8.76 3.63A12.32 12.32 0 0 1 28.4 15.1c-.01 6.83-5.57 12.39-12.4 12.39Zm10.54-22.95A15.09 15.09 0 0 0 15.99 0C7.18 0 .02 7.16.02 15.96c0 2.81.73 5.56 2.11 7.98L0 32l8.29-2.12a15.92 15.92 0 0 0 7.66 1.95h.01c8.8 0 15.96-7.16 15.96-15.96 0-4.27-1.66-8.28-4.68-11.44Z" />
					</svg>
					Abrir WhatsApp {contactInfo.whatsappContact}
				</a>
			</article>

			<div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-1">
				<article class="rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-sm">
					<p class="text-sm font-semibold uppercase tracking-[0.28em] text-slate-500">Correo</p>
					<a class="mt-3 inline-flex items-center gap-3 text-lg font-bold text-slate-950 transition hover:text-sky-700" href={`mailto:${contactInfo.email}`}>
						<svg class="h-5 w-5 text-sky-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
							<path d="M4 5h16v14H4z" /><path d="m4 7 8 6 8-6" />
						</svg>
						{contactInfo.email}
					</a>
				</article>

				<article class="rounded-[1.5rem] border border-slate-200 bg-white p-6 shadow-sm">
					<p class="text-sm font-semibold uppercase tracking-[0.28em] text-slate-500">Redes sociales</p>
					<ul class="mt-4 space-y-3 text-sm text-slate-600">
						<li>
							<a class="group inline-flex items-center gap-3 transition hover:text-slate-950" href={contactInfo.instagram} target="_blank" rel="noopener noreferrer">
								<svg class="h-5 w-5 text-pink-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.5" cy="6.5" r=".7" fill="currentColor" stroke="none" />
								</svg>
								Instagram
							</a>
						</li>
						<li>
							<a class="group inline-flex items-center gap-3 transition hover:text-slate-950" href={contactInfo.whatsappHref} target="_blank" rel="noopener noreferrer">
								<svg class="h-5 w-5 text-emerald-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
									<path d="M20 11.5a8 8 0 0 1-11.8 7L4 20l1.5-4.1A8 8 0 1 1 20 11.5Z" /><path d="M8.5 9.2c.2 2 2.3 4.1 4.3 4.3l1.1-1.1 1.7.7c.2.1.3.3.2.5-.3 1-1 1.5-2 1.3-3.1-.5-5-2.4-5.5-5.2-.2-1 .4-1.7 1.3-2 .2-.1.4 0 .5.2l.7 1.7-1.1 1.1Z" />
								</svg>
								WhatsApp {contactInfo.whatsappContact}
							</a>
						</li>
					</ul>
				</article>
			</div>
		</div>
	</section>
</Layout>